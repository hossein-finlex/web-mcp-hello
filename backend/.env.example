# Copy to backend/.env and fill in. The key never leaves the backend.
ANTHROPIC_API_KEY=sk-ant-...

# Model. Leave as-is unless you have a reason to change it.
CLAUDE_MODEL=claude-opus-5

# Set to 1 to run the agent loop against a scripted stub instead of the real
# API. Useful for exercising the WebMCP round-trip without spending tokens.
MOCK_LLM=0

# Postgres from docker-compose.yml. Port 5434 avoids the local Homebrew
# postgres on 5432 and another project's container on 5433.
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5434/portfolio

# Seed the database on startup when it is empty.
AUTO_SEED=1

# Where the React dev server runs, for CORS.
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
